{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreenCut",
  "version": "0.1.0",
  "identifier": "com.screencut.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ScreenCut",
        "width": 480,
        "height": 720,
        "minWidth": 480,
        "minHeight": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "transparent": true,
        "decorations": true,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "public.app-category.video",
    "shortDescription": "Screen recorder",
    "longDescription": "Cross-platform screen recorder built with Rust + Tauri",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
